<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YtTranscript</RootNamespace>
    <AssemblyName>YtTranscript</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- other platforms and tests live in their own projects -->
    <Compile Remove="mac/**;tests/**;Audio/AudioConverter.Mac.cs" />
    <None Remove="mac/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- YouTube changes often, so always use the latest 6.x -->
    <PackageReference Include="YoutubeExplode" Version="6.*" />
    <PackageReference Include="Whisper.net" Version="1.*" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.*" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
